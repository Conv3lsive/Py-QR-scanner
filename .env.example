# SMTP settings
SMTP_EMAIL="your@email.com"
SMTP_PASSWORD="your_password"
SMTP_HOST="smtp.example.com"
SMTP_PORT=465

EMAIL_SUBJECT="Ваша работа"
EMAIL_BODY="Пожалуйста, проверьте архив"

